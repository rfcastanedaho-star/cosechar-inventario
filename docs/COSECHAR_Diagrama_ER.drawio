l id="c31" value="0..N" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b30000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1635" y="898" width="34" height="16" as="geometry"/></mxCell><mxCell id="c32" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b30000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1737" y="744" width="34" height="16" as="geometry"/></mxCell><mxCell id="c33" value="0..N" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b30000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="19" y="298" width="34" height="16" as="geometry"/></mxCell><mxCell id="c34" value="0..1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b30000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="997" y="304" width="34" height="16" as="geometry"/></mxCell><mxCell id="c35" value="0..N" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b30000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="997" y="341" width="34" height="16" as="geometry"/></mxCell><mxCell id="titulo" value="COSECHAR E.I.R.L. - Diagrama entidad-relación (13 entidades, 18 relaciones)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="12" width="1000" height="30" as="geometry"/></mxCell><mxCell id="leyenda" value="&lt;b&gt;Cardinalidades&lt;/b&gt; (el número junto a una entidad indica cuántas veces participa por cada ocurrencia de la otra): &lt;b&gt;1&lt;/b&gt; = exactamente uno · &lt;b&gt;0..1&lt;/b&gt; = cero o uno · &lt;b&gt;0..N&lt;/b&gt; = cero o varios · &lt;b&gt;1..N&lt;/b&gt; = uno o varios.&lt;br&gt;&lt;b&gt;Llaves:&lt;/b&gt; PK = primaria · FK = foránea · UK = única · IDX = índice (relación polimórfica de auditoría, sin FK).&lt;br&gt;&lt;b&gt;Colores:&lt;/b&gt; azul = inventario · naranja = compras · morado = ventas · gris = transversales (usuarios, almacenes, historial)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;strokeColor=#999999;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="1115" width="1100" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="modelo-logico" name="2. Modelo lógico completo"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1555" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e_users" value="users" style="swimlane;fontStyle=1;fontSize=12;align=center;startSize=28;html=1;whiteSpace=wrap;collapsible=0;marginBottom=0;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1500" y="964" width="250" height="128" as="geometry"/></mxCell><mxCell id="e_users_k0" value="PK" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="e_users"><mxGeometry y="28" width="44" height="20" as="geometry"/></mxCell><mxCell id="e_users_n0" value="id : bigint" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=5;spacingLeft=2;strokeColor=none;fillColor=none;" vertex="1" parent="e_users"><mxGeometry x="44" y="28" width="206" height="20" as="geometry"/></mxCell><mxCell id="e_users_k1" value="" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="e_users"><mxGeometry y="48" width="44" height="20" as="geometry"/></mxCell><mxCell id="e_users_n1" value="name : varchar" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;spacingLeft=2;strokeColor=none;fillColor=