fontSize=11;fontStyle=1;fontColor=#b30000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1715" y="882" width="34" height="16" as="geometry"/></mxCell><mxCell id="c30" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b30000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1625" y="1100" width="34" height="16" as="geometry"/></mxCell><mxCell id="c31" value="0..N" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b30000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1625" y="1158" width="34" height="16" as="geometry"/></mxCell><mxCell id="c32" value="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b30000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1757" y="1004" width="34" height="16" as="geometry"/></mxCell><mxCell id="c33" value="0..N" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b30000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="19" y="348" width="34" height="16" as="geometry"/></mxCell><mxCell id="c34" value="0..1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b30000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1037" y="434" width="34" height="16" as="geometry"/></mxCell><mxCell id="c35" value="0..N" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b30000;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1037" y="491" width="34" height="16" as="geometry"/></mxCell><mxCell id="titulo" value="COSECHAR E.I.R.L. - Modelo lógico de la base de datos (todas las columnas)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="12" width="1000" height="30" as="geometry"/></mxCell><mxCell id="leyenda" value="&lt;b&gt;Cardinalidades&lt;/b&gt; (el número junto a una entidad indica cuántas veces participa por cada ocurrencia de la otra): &lt;b&gt;1&lt;/b&gt; = exactamente uno · &lt;b&gt;0..1&lt;/b&gt; = cero o uno · &lt;b&gt;0..N&lt;/b&gt; = cero o varios · &lt;b&gt;1..N&lt;/b&gt; = uno o varios.&lt;br&gt;&lt;b&gt;Llaves:&lt;/b&gt; PK = primaria · FK = foránea · UK = única · IDX = índice (relación polimórfica de auditoría, sin FK).&lt;br&gt;&lt;b&gt;Colores:&lt;/b&gt; azul = inventario · naranja = compras · morado = ventas · gris = transversales (usuarios, almacenes, historial).&lt;br&gt;&lt;b&gt;Símbolos de la línea:&lt;/b&gt; patas de gallo = &quot;varios&quot;; barra = &quot;uno&quot;; círculo = &quot;cero (opcional)&quot;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=6;strokeColor=#999999;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="1435" width="1100" height="85" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>